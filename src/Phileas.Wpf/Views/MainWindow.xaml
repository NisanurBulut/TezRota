<Window x:Class="Phileas.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Phileas.Wpf.Controls"
        xmlns:v="clr-namespace:Phileas.Wpf.Views"
        Title="Phileas – Route Optimizer" Icon="pack://application:,,,/Assets/phileas.ico" Width="1240" Height="720" MinWidth="1100" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Canvas IsHitTestVisible="False">
            <Ellipse Canvas.Right="-160" Canvas.Top="-200" Width="620" Height="620" Canvas.Left="760">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#A07AA2E3" Offset="0" />
                        <GradientStop Color="#007AA2E3" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Canvas.Left="-180" Canvas.Top="470" Width="560" Height="560">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#90C97C5D" Offset="0" />
                        <GradientStop Color="#00C97C5D" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

    <Grid Margin="20,12,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Margin="0,0,0,14" Padding="16,10" CornerRadius="16" Background="{StaticResource BannerBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="5" Direction="270" Opacity="0.3" Color="#2F4E86" />
            </Border.Effect>
            <DockPanel>
                <Image DockPanel.Dock="Left" Source="{StaticResource LogoImage}" Width="44" Height="44" Margin="0,0,14,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Phileas" FontSize="22" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Travelling salesman · Simulated Annealing vs Tabu Search" FontSize="12" Foreground="#E6FFFFFF" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Margin="0,0,18,0">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                    <Button Command="{Binding CompareCommand}" Style="{StaticResource PrimaryActionButton}" AutomationProperties.Name="Compare both methods">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" Margin="0,2,10,0" />
                            <TextBlock Text="Compare both methods" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource ActionButton}" Margin="0,8,0,0"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" Margin="0,2,10,0" Foreground="{StaticResource ErrorBrush}" />
                            <TextBlock Text="Cancel" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Problem" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                                <c:LabeledSlider Header="Cities" Value="{Binding CityCount}" Minimum="5" Maximum="60" Step="1" Accent="{StaticResource PrimaryBrush}" />
                                <c:LabeledSlider Header="Speed" Value="{Binding SpeedKmPerHour}" Minimum="20" Maximum="120" Step="5" Format="0 &quot;km/h&quot;" Accent="{StaticResource PrimaryBrush}" />
                                <c:LabeledSlider Header="Animation" Value="{Binding AnimationSeconds}" Minimum="1" Maximum="10" Step="0.5" Format="0.0 &quot;s&quot;" Accent="{StaticResource PrimaryBrush}" />
                                <Button Padding="14,8" AutomationProperties.Name="New cities" Command="{Binding GenerateCitiesCommand}" Style="{StaticResource ActionButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" Margin="0,2,10,0" />
                                        <TextBlock Text="New cities" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <TabControl>
                                <TabItem Header="Simulated Annealing" Foreground="{StaticResource AnnealingBrush}">
                                    <StackPanel DataContext="{Binding Annealing}">
                                        <c:LabeledSlider Header="Temperature" Value="{Binding Temperature}" Minimum="10" Maximum="500" Step="10" Accent="{StaticResource AnnealingBrush}" />
                                        <c:LabeledSlider Header="Iterations per step" Value="{Binding Iterations}" Minimum="100" Maximum="3000" Step="100" Accent="{StaticResource AnnealingBrush}" />
                                        <c:LabeledSlider Header="Cooling rate" Value="{Binding CoolingRate}" Minimum="0.9" Maximum="0.999" Step="0.001" Format="0.000" Accent="{StaticResource AnnealingBrush}" />
                                        <Button Padding="12,6" Style="{StaticResource ActionButton}" AutomationProperties.Name="Run Simulated Annealing"
                                                Command="{Binding DataContext.RunAnnealingCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource AnnealingBrush}" Margin="0,2,8,0" />
                                                <TextBlock Text="Run annealing only" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </TabItem>
                                <TabItem Header="Tabu Search" Foreground="{StaticResource TabuBrush}">
                                    <StackPanel DataContext="{Binding Tabu}">
                                        <c:LabeledSlider Header="Tabu list length" Value="{Binding TabuLength}" Minimum="1" Maximum="20" Step="1" Accent="{StaticResource TabuBrush}" />
                                        <c:LabeledSlider Header="Neighbours per iteration" Value="{Binding NeighbourCount}" Minimum="1" Maximum="50" Step="1" Accent="{StaticResource TabuBrush}" />
                                        <c:LabeledSlider Header="Iterations" Value="{Binding Iterations}" Minimum="100" Maximum="3000" Step="100" Accent="{StaticResource TabuBrush}" />
                                        <Button Padding="12,6" Style="{StaticResource ActionButton}" AutomationProperties.Name="Run Tabu Search"
                                                Command="{Binding DataContext.RunTabuCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource TabuBrush}" Margin="0,2,8,0" />
                                                <TextBlock Text="Run tabu only" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="180" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <v:AlgorithmPanel DataContext="{Binding Annealing}" Accent="{StaticResource AnnealingBrush}" />
                <v:AlgorithmPanel Grid.Column="2" DataContext="{Binding Tabu}" Accent="{StaticResource TabuBrush}" />

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Convergence" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                        <c:ConvergenceView AnnealingResult="{Binding Annealing.Result}" AnnealingReplayed="{Binding Annealing.DisplayedIteration}" AnnealingBrush="{StaticResource AnnealingBrush}"
                                           TabuResult="{Binding Tabu.Result}" TabuReplayed="{Binding Tabu.DisplayedIteration}" TabuBrush="{StaticResource TabuBrush}" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" DataContext="{Binding Results}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Right" Text="green = shortest tour" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <TextBlock Text="Results" Style="{StaticResource CardTitle}" />
                        </DockPanel>
                        <TextBlock Text="Compare both methods to see which finds the shorter tour from the same random start."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap">
                            <TextBlock.Visibility>
                                <Binding Path="HasResults">
                                    <Binding.Converter>
                                        <v:InverseBooleanToVisibilityConverter />
                                    </Binding.Converter>
                                </Binding>
                            </TextBlock.Visibility>
                        </TextBlock>
                        <Grid Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.3*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.1*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Method" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Column="1" Text="Distance" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Column="2" Text="Travel time" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Column="3" Text="Solve time" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Column="4" Text="Improved" Style="{StaticResource Caption}" />
                            </Grid>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Rows}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="0,8" Margin="0,0,0,4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBest}" Value="True">
                                                            <Setter Property="Background" Value="#4A5B8A72" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.3*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.1*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Method}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Distance}" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Grid.Column="2" Text="{Binding TravelTime}" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Grid.Column="3" Text="{Binding SolveTime}" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Grid.Column="4" Text="{Binding Improvement}" Foreground="{StaticResource SuccessBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</Window>
