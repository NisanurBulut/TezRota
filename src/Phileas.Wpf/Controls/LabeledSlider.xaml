<UserControl x:Class="Phileas.Wpf.Controls.LabeledSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel Margin="0,0,0,10">
        <DockPanel>
            <TextBlock x:Name="ValueText" DockPanel.Dock="Right" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding Header, ElementName=Root}" Foreground="{DynamicResource TextSecondaryBrush}" />
        </DockPanel>
        <Slider x:Name="Slider" Margin="0,4,0,0"
                Minimum="{Binding Minimum, ElementName=Root}"
                Maximum="{Binding Maximum, ElementName=Root}"
                TickFrequency="{Binding Step, ElementName=Root}"
                IsSnapToTickEnabled="True"
                Value="{Binding Value, ElementName=Root, Mode=TwoWay}"
                Foreground="{Binding Accent, ElementName=Root}"
                ValueChanged="OnSliderValueChanged" />
    </StackPanel>
</UserControl>
